<!DOCTYPE html>
<html>
IA02240
<head> 
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Jaiz Risk Register</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <link rel="shortcut icon" href="~/Content/assets/images/jaizicon.ico">
    <!-- DataTables -->
    <link href="~/Content/assets/plugins/datatables/jquery.dataTables.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/plugins/datatables/buttons.bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/plugins/datatables/fixedHeader.bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/plugins/datatables/responsive.bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/plugins/datatables/dataTables.bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/assets/plugins/datatables/scroller.bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- Sweet Alert -->
    <link href="~/Content/assets/plugins/bootstrap-sweetalert/sweet-alert.css" rel="stylesheet" type="text/css">
    <link href="~/Content/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css">
    <link href="~/Content/assets/css/icons.css" rel="stylesheet" type="text/css">
    <link href="~/Content/assets/css/style.css" rel="stylesheet" type="text/css">
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css">
    <!-- Light Box 2 CSS -->
    <link href="~/Content/assets/plugins/lightbox2-master/dist/css/lightbox.min.css" rel="stylesheet" type="text/css">
</head>
<body class="fixed-left">
    <!-- Begin page -->
    <div id="wrapper">
        <!-- Top Bar Start -->
        <div class="topbar">
            <!-- LOGO -->
            <div class="topbar-left">
                <div class="text-center">
                    <a href="javascript:void(0)" class="logo"><span>Jaiz Bank&nbsp;Plc</span></a>
                    <a href="javascript:void(0)" class="logo-sm"><span>J</span></a>
                </div>
            </div>

            <!-- Button mobile view to collapse sidebar menu -->
            <div class="navbar navbar-default" role="navigation">
                <div class="container">
                    <div class="">
                        <div class="pull-left">
                            <button type="button" class="button-menu-mobile open-left waves-effect waves-light">
                                <i class="ion-navicon"></i>
                            </button>
                            <span class="clearfix"></span>
                        </div>
                        <ul class="nav navbar-nav navbar-right pull-right">

                            <li class="hidden-xs">
                                <a href="#" id="btn-fullscreen" class="waves-effect waves-light notification-icon-box"><i class="mdi mdi-fullscreen"></i></a>
                            </li>
                            <li class="dropdown">
                                <a href="" class="dropdown-toggle profile waves-effect waves-light" data-toggle="dropdown" aria-expanded="true">
                                    <img src="~/Content/jaiz-logo-circle.jpg" alt="user-img" class="img-circle">
                                    <span class="profile-username">
                                        <span id="user-id">Staff ID: @ViewBag.User</span> <br />
                                        @* <small> Branch: @ViewBag.Branch (@ViewBag.BranchCode) </small> *@
                                    </span>
                                </a>
                            </li>
                        </ul>
                    </div>
                    <!--/.nav-collapse -->
                </div>
            </div>
        </div>
        <!-- Top Bar End -->
        <!-- ========== Left Sidebar Start ========== -->
        <div class="left side-menu">
            <div class="sidebar-inner slimscrollleft">

                <div class="user-details">
                    <div class="text-center">
                        <img src="~/Content/jaiz-logo-circle.jpg" alt="" class="img-circle">
                    </div>
                </div>
                <!--- Divider -->

                <div id="sidebar-menu">
                    <ul>

                        @if (ViewBag.LoginRole == "RiskEntry")
                        {
                            <li>
                                <a asp-controller="RiskEntry" asp-action="Index" class="waves-effect"><i class="mdi mdi-table-edit"></i> <span>RISK SCORE ENTRY</span> <span class="pull-right"></span></a>
                            </li>
                            
                        }
                        else if (ViewBag.LoginRole == "Reviewer")
                        {
                            <li class="has_sub">
                                <a href="javascript:void(0);" class="waves-effect"><i class="mdi mdi-book-open"></i> <span>SCHEDULES</span> <span class="pull-right"></span></a>
                                <ul class="list-unstyled">
                                    <li><a asp-controller="SubmissionSchedule" asp-action="Create">Create Schedule</a></li>
                                    <li><a asp-controller="SubmissionSchedule" asp-action="Get">View Schedules</a></li>
                                </ul>
                            </li>
                            <li>
                                <a asp-controller="PullForEdit" asp-action="Index" class="waves-effect"><i class="mdi mdi-table-edit"></i> <span>PULL FOR EDIT</span> <span class="pull-right"></span></a>
                            </li>
                            <li>
                                <a asp-controller="EditRiskRecord" asp-action="Index" class="waves-effect"><i class="mdi mdi-table-edit"></i> <span>EDIT RISK RECORD</span> <span class="pull-right"></span></a>
                            </li>
                            <li>
                                <a asp-controller="AuditLog" asp-action="Index" class="waves-effect"><i class="mdi mdi-format-list-numbers"></i> <span>AUDIT LOG</span> <span class="pull-right"></span></a>
                            </li>
                            
                        } else if (ViewBag.LoginRole == "Approver")
                        {
                            <li class="has_sub">
                                <a href="javascript:void(0);" class="waves-effect"><i class="mdi mdi-book-open"></i> <span>SCHEDULES</span> <span class="pull-right"></span></a>
                                <ul class="list-unstyled">
                                    <li><a asp-controller="SubmissionSchedule" asp-action="Create">Create Schedule</a></li>
                                    <li><a asp-controller="SubmissionSchedule" asp-action="Get">View Schedules</a></li>
                                </ul>
                            </li>
                            <li>
                                <a asp-controller="ApproveRiskChanges" asp-action="Index" class="waves-effect"><i class="mdi mdi-check-all"></i> <span>APPROVALS</span> <span class="pull-right"></span></a>
                            </li>
                            <li>
                                <a asp-controller="PullForEdit" asp-action="Index" class="waves-effect"><i class="mdi mdi-tooltip-edit"></i> <span>PULL FOR EDIT</span> <span class="pull-right"></span></a>
                            </li>
                            <li>
                                <a asp-controller="EditRiskRecord" asp-action="Index" class="waves-effect"><i class="mdi mdi-table-edit"></i> <span>EDIT RISK RECORD</span> <span class="pull-right"></span></a>
                            </li>
                            <li>
                                <a asp-controller="AuditLog" asp-action="Index" class="waves-effect"><i class="mdi mdi-format-list-numbers"></i> <span>AUDIT LOG</span> <span class="pull-right"></span></a>
                            </li>
                            <li>
                                <a asp-controller="SubmissionSchedule" asp-action="ProfileSubmitter" class="waves-effect"><i class="mdi mdi-tooltip-edit"></i> <span>PROFILE SUBMITTER</span> <span class="pull-right"></span></a>
                            </li>
                        }
                        <li>
                            <a href="https://app.powerbi.com/groups/c8fc5a31-1ae8-460d-9500-589568e069af/list?experience=power-bi" class="waves-effect"><i class="mdi mdi-view-dashboard"></i><span>Go to Dashboard</span></a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="LogOut" class="waves-effect"><i class="glyphicon glyphicon-log-out"></i><span> LOG OUT</span></a>
                        </li>
                    </ul>
                </div>
                <div class="clearfix"></div>
            </div> <!-- end sidebarinner -->
        </div>
        <!-- Left Sidebar End -->
        <!-- Start right Content here -->

        <div class="content-page">
            @RenderBody()
            <footer class="footer">
                &copy; @DateTime.Now.Year - Powered By Jaiz Bank Application Solutions
            </footer>

        </div>

        <!-- End Right content here -->


    </div>
    <!-- END wrapper -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Select all menu items with submenus
            const scheduleMenus = document.querySelectorAll(".has_sub > a");

            scheduleMenus.forEach(menu => {
                menu.addEventListener("click", function (e) {
                    e.preventDefault();

                    const parentLi = this.parentElement; // li.has_sub
                    const submenu = parentLi.querySelector("ul");

                    // Toggle visibility
                    if (submenu.style.display === "block") {
                        submenu.style.display = "none";
                        this.querySelector(".mdi").classList.remove("mdi-minus");
                        this.querySelector(".mdi").classList.add("mdi-plus");
                    } else {
                        submenu.style.display = "block";
                        this.querySelector(".mdi").classList.remove("mdi-plus");
                        this.querySelector(".mdi").classList.add("mdi-minus");
                    }
                });
            });
        });
    </script>


    <!--End App Specific Script-->
    @RenderSection("scripts", required: false)
</body>
</html>
